{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#session-view": [
        "./src/session-view-v2.tsx"
      ],
      "@opencode/app": [
        "../vendor/opencode-v2/packages/app/src/index.ts"
      ],
      "@opencode/app/desktop": [
